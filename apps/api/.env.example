# Server
PORT=3001

# Supabase (JWT verification + service-role data access for the coach)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The account `pnpm seed` writes and `sim.py login` signs in as. Required before
# `pnpm wt:new --db`: a branch database's auth.users is empty, so setup creates
# this account in it and there is nobody to sign in as without these two.
TEST_USER_EMAIL=you+simtest@example.com
TEST_USER_PASSWORD=a-long-random-password

# OpenAI — Whisper transcription for voice input only
OPENAI_API_KEY=sk-your-openai-api-key

# In-app coach (Claude Agent SDK). Auth rides the Claude subscription:
# run `claude setup-token` and paste the result here. On a machine where
# Claude Code is already logged in this can stay empty.
CLAUDE_CODE_OAUTH_TOKEN=
# Optional overrides
COACH_MODEL=claude-opus-5
COACH_EFFORT=
