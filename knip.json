{
  "$schema": "https://unpkg.com/knip@6/schema.json",

  // Dead-code detection for the whole workspace. ESLint sees one file at a time,
  // so it catches an unused local and nothing else; knip resolves the whole
  // import graph and answers the question ESLint cannot: is anything still
  // reaching this?
  //
  // Two things are excluded below and nothing else. Most entries are code that
  // *is* reached, just not through an import knip can follow. The rest is code
  // parked on purpose — the `max-lines` bargain: it names what will delete it or
  // use it, so the exception has an owner and an end. Real dead code with no
  // owner is deleted (AGENTS.md §2), never masked here.

  "workspaces": {
    ".": {
      // Deno edge functions, deployed to Supabase and invoked by pg_cron —
      // see 20260202000002_add_notification_cron_jobs.sql, which schedules
      // send-scheduled-notifications, schedule-daily-reminders and
      // check-pending-habits through invoke_edge_function(). Nothing in this
      // repo imports them, so without this line all three read as dead.
      "entry": [
        "supabase/functions/**/index.ts",
        // The autopilot run ledger. The autopilot skill runs it with `node`
        // (.claude/skills/autopilot/SKILL.md, "The run ledger"); nothing imports
        // it. Its test is found on its own, through the root `node --test` script.
        "scripts/autopilot-run.mjs"
      ]
    },

    "apps/mobile": {
      // Parked, not reached: HAB-90 keeps this one file because goals are coming
      // back to the app. Note that docs/native-rewrite-plan.md (2026-08-20) says
      // the opposite — it cuts Goals entirely — and HAB-90 (2026-08-25) is the
      // newer of the two. HAB-131 reconciles them; whichever way it lands, this
      // entry goes with it.
      "ignore": ["components/GoalEditorModal.tsx"],

      "ignoreDependencies": [
        // Inferred by knip's Expo plugin from app.json keys rather than from
        // any import, and neither is installed: `userInterfaceStyle` implies
        // expo-system-ui, an EAS project id implies expo-updates. The app
        // builds without them. Worth revisiting if Android ever ships, since
        // expo-system-ui is what applies `userInterfaceStyle` there.
        "expo-updates",
        "expo-system-ui"
      ]
    }
  },

  "ignoreDependencies": [
    // The @sentry/react-native/expo plugin (apps/mobile/app.json) shells out to
    // it during an EAS build so production builds embed the JS bundle. Nothing
    // imports it, and nothing should.
    "@sentry/cli"
  ],

  // The Supabase CLI is deliberately not a dependency: CI pins it with
  // supabase/setup-cli and locally it comes from npx. Declaring it in
  // package.json would give us a second version to keep in sync with that pin.
  // Deliberately not set, and worth knowing: knip's default
  // `includeEntryExports: false` means a symbol re-exported from a package
  // barrel is never checked, so packages/shared and packages/habitron's public
  // surfaces sit outside this report — `pnpm knip --include-entry-exports`
  // finds 29 there. Writing the key in explicitly, even as `false`, would be
  // worse than leaving it out: a value in the config overrides that flag, so
  // the one command that reveals the gap would silently report clean.
  // HAB-132 owns turning it on, which is the only way "the whole import graph"
  // is true.
  "ignoreBinaries": ["supabase"]
}
